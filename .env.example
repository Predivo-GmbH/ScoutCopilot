VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile site key (public — safe to expose in the bundle) for the sign-in /
# signup / forgot-password bot-protection widget. No key has been minted for ScoutCopilot yet
# (the fleet holds no Cloudflare API token) — leave unset. When unset, TurnstileWidget renders
# nothing and the auth calls it feeds stay a no-op, same as before this variable existed.
VITE_TURNSTILE_SITE_KEY=

# Stripe price IDs (from Stripe Dashboard > Products)
VITE_STRIPE_PRICE_SCOUT_MONTH=price_xxx
VITE_STRIPE_PRICE_SCOUT_YEAR=price_xxx
VITE_STRIPE_PRICE_PRO_MONTH=price_xxx
VITE_STRIPE_PRICE_PRO_YEAR=price_xxx
VITE_STRIPE_PRICE_CLUB_MONTH=price_xxx
VITE_STRIPE_PRICE_CLUB_YEAR=price_xxx
