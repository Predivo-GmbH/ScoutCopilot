<IfModule mod_headers.c>
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-G9SM0lBhv0poELF/0BMjMAeCexCDay+pwxZiCw9cZLg='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://api.stripe.com; font-src 'self'; frame-src 'self'; object-src 'none'; manifest-src 'self'; frame-ancestors 'self';"
</IfModule>

<IfModule mod_dir.c>
  # Prerendered routes exist as physical dirs (en/, en/for/<slug>/, ...). Without
  # this, mod_dir 301-redirects the canonical slashless URL (/en -> /en/) BEFORE
  # our rewrite can serve <dir>/index.html. Off = our rewrite handles it, 200 direct.
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect www to non-www (canonical domain)
  RewriteCond %{HTTP_HOST} ^www\.scoutcopilot\.com [NC]
  RewriteRule ^(.*)$ https://scoutcopilot.com/$1 [L,R=301]

  # Strip trailing slashes (prevents 500 errors on /path/ variants)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [R=301,L]

  # Redirect bare root "/" to default language "/en"
  RewriteRule ^$ /en [R=301,L]

  # 301 redirect old non-prefixed URLs to /en/ (preserves SEO equity)
  RewriteCond %{REQUEST_URI} !^/(en|de)(/|$)
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{REQUEST_URI} !^/fonts/
  RewriteCond %{REQUEST_URI} !^/auth/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)$ /en/$1 [R=301,L]

  # Serve prerendered SEO pages. Public routes (landing, pricing, legal, /for/*,
  # /guides/*) are prerendered at build time (scripts/prerender.ts) to
  # dist/<route>/index.html so crawlers get fully rendered HTML, not the empty SPA
  # shell. When the requested path is a real prerendered directory, serve its
  # index.html with an INTERNAL rewrite (no 301 slash redirect) — a direct 200 with
  # rendered content. Only matches real prerendered dirs, so SPA routes fall through.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*?)/?$ /$1/index.html [L]

  # If the request is for an existing file or directory, serve it directly
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Otherwise, serve index.html (SPA client-side routing)
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # HTML: must revalidate every time
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Hashed assets (JS/CSS/fonts in /assets/): immutable long-cache
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
