  "typography": {
    "font-family": {
      "heading": "'Inter', system-ui, -apple-system, sans-serif",
      "body": "'Inter', system-ui, -apple-system, sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', 'Consolas', monospace"
    },
    "scale": {
      "display-lg": { "size": "3.5rem", "line-height": "1.1", "weight": 700, "letter-spacing": "-0.02em" },
      "display": { "size": "3rem", "line-height": "1.1", "weight": 700, "letter-spacing": "-0.02em" },
      "h1": { "size": "2.25rem", "line-height": "1.2", "weight": 700, "letter-spacing": "-0.01em" },
      "h2": { "size": "1.75rem", "line-height": "1.25", "weight": 600, "letter-spacing": "-0.01em" },
      "h3": { "size": "1.375rem", "line-height": "1.3", "weight": 600, "letter-spacing": "0" },
      "h4": { "size": "1.125rem", "line-height": "1.4", "weight": 600, "letter-spacing": "0" },
      "body-lg": { "size": "1rem", "line-height": "1.6", "weight": 400, "letter-spacing": "0" },
      "body": { "size": "0.9375rem", "line-height": "1.6", "weight": 400, "letter-spacing": "0" },
      "body-sm": { "size": "0.875rem", "line-height": "1.5", "weight": 400, "letter-spacing": "0" },
      "label-lg": { "size": "0.875rem", "line-height": "1.4", "weight": 500, "letter-spacing": "0.02em" },
      "label": { "size": "0.8125rem", "line-height": "1.4", "weight": 500, "letter-spacing": "0.02em" },
      "label-sm": { "size": "0.75rem", "line-height": "1.3", "weight": 500, "letter-spacing": "0.05em" },
      "caption": { "size": "0.6875rem", "line-height": "1.3", "weight": 400, "letter-spacing": "0.03em" }
    },
    "rules": {
      "numbers-and-stats": "Always use mono font family",
      "labels-uppercase": "label-sm uses text-transform: uppercase with +0.05em letter-spacing",
      "display-tight": "Display and h1 use negative letter-spacing for premium feel"
    }
  },

  "spacing": {
    "base": "4px",
    "scale": {
      "0.5": "2px",
      "1": "4px",
      "1.5": "6px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "20": "80px",
      "24": "96px",
      "32": "128px"
    }
  },

  "border-radius": {
    "sm": "2px",
    "md": "6px",
    "lg": "8px",
    "pill": "9999px",
    "default": "6px",
    "rules": {
      "buttons": "6px (md) — never pill",
      "cards": "6px (md)",
      "inputs": "6px (md)",
      "modals": "8px (lg)",
      "badges": "2px (sm) — never pill"
    }
  },

  "borders": {
    "default": "1px solid #434655",
    "focus": "1px solid #2563EB",
    "error": "1px solid #FFB4AB",
    "selected": "2px solid #2563EB",
    "ghost": "1px solid rgba(67, 70, 85, 0.2)",
    "rules": {
      "philosophy": "Border-first design — borders define containers, not shadows",
      "asymmetric": "Prefer 2-3 sided borders (e.g., left + bottom) for editorial feel",
      "no-full-dividers": "Never use full-width horizontal dividers in lists"
    }
  },

  "elevation": {
    "none": "none",
    "rules": {
      "philosophy": "No drop shadows. Use tonal stepping (surface hierarchy) for depth.",
      "glassmorphism": "surface-bright at 60% opacity + 20px backdrop-blur for hover menus only"
    }
  },

  "animation": {
    "duration": {
      "fast": "100ms",
      "normal": "150ms",
      "medium": "200ms",
      "slow": "300ms",
      "page": "400ms"
    },
    "easing": {
      "entrance": "ease-out",
      "exit": "ease-in",
      "transform": "ease-in-out"
    },
    "rules": {
      "reduce-motion": "All animations respect prefers-reduced-motion",
      "philosophy": "Purposeful, not performative — every animation communicates state change"
    }
  },

  "layout": {
    "max-width": "1280px",
    "grid-columns": 12,
    "gutter": "24px",
    "sidebar": { "expanded": "256px", "collapsed": "64px" },
    "breakpoints": {
      "mobile": "375px",
      "tablet": "768px",
      "desktop": "1280px",
      "wide": "1536px"
    }
  },

  "icons": {
    "set": "Lucide",
    "stroke-weight": "1.5px",
    "sizes": {
      "sm": "16px",
      "md": "20px",
      "default": "24px"
    },
    "rules": "Functional only — icons communicate meaning, not decoration"
  },

  "anti-slop": [
    "NO gradient backgrounds on sections or cards",
    "NO generic stock imagery — use data visualizations, radar charts, pitch diagrams",
    "NO pill buttons (rounded-full) — max 6px radius",
    "NO decorative icons without functional purpose",
    "NO pastel washes — colors are bold or neutral",
    "NO AI sparkles, gradient text, or 'powered by AI' badges",
    "NO excessive whitespace in data views — information-dense when showing data",
    "NO shadow-heavy design — borders and tonal fills define containers",
    "NO fonts other than Inter (heading/body) and JetBrains Mono (data)"
  ]
}
